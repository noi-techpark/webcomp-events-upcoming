    "image": "wcs-logo.png",
    "searchTags": [
      "events"
    ],
    "dist": {
        "basePath": "dist",
        "files": [
            "events-upcoming.min.js"
        ],
        "scripts": []
    },
    "configuration": {
        "tagName": "events-upcoming",
        "options": [
            {
                "key": "source",
                "type": "multiselect",
                "label": "Filter by dataprovider. Provide a comma-separated list of sources (e.g., 'trevilab, drin, lts, retealfemminile, wnet, studiopink, momentus, noi') or 'null' for all.",
                "required": false,        
                "options": {
                   "values": ["noi","trevilab","drin","ebms","lts","momentus","nobis","peer","unibz","retealfemminile","studiopink","wnet"]
                }
            },
            {
                "key": "theme",
                "type": "select",
                "label": "Select a UI theme/skin.",
                "required": false,
                "options": {
                    "values": ["default", "eurac", "noi"],
                    "default": "default"
                }
            },
            {
                "key": "show-room-on-main",
                "type": "select",
                "label": "Whether to display the specific room for the upcoming meeting on the main card.",
                "required": false,
                "options": {
                    "values": ["false", "true"],
                    "default": "false"
                }
            },
            {
                "key": "tags",
                "type": "text",
                "label": "Filter by tags. Provide a comma-separated list of tags.",
                "required": false,        
                "options": {
                  "default": ""
                }
            },
            {
                "key": "published-on",
                "type": "text",
                "label": "Filter by published on. Provide a comma-separated list of publication flags.",
                "required": false,        
                "options": {
                  "default": ""
                }
            },
            {
                "key": "expanded",
                "type": "select",
                "label": "Whether to show events fully expanded by default.",
                "required": false,
                "options": {
                    "values": ["false", "true"],
                    "default": "false"
                }
            },
              {
                "key": "language",
                "type": "select",
                "label": "language to show (if no language is checked the events will change language each x seconds defined in language-rotation-interval)",
                "required": false,        
                "options": {
                  "values": [
                    "",
                    "de",
                    "it",        
                    "en"
                  ],
                  "default":"en"
                }
            },
              {
                "key": "location",
                "type": "text",
                "label": "Location Filter (pass type + id check out https://tourism.opendatahub.com/v1/Location)",
                "required": false,
                "options": {
                  "default": ""
                }
              },
            {
                "key": "max-events",
                "type": "number",
                "label": "Max number of events to display",
                "required": false,
                "options": {
                    "default": 12
                }
            },
            {
                "key": "location-to-show",
                "type": "select",
                "label": "Select what locationinfo to show",
                "required": false,        
                "options": {
                  "values": [
                    "district",
                    "municipality",        
                    "tourismassociation",
                    "region",
                    "location"
                  ],
                  "default":"district"
                }
            },
            {
                "key": "event-sortmode",
                "type": "select",
                "label": "Select what sortmode for events, upcoming = multiple day events first, upcomingspecial = single day events first, upcomingspecialdesc = sort the nearest event to datetime now first",
                "required": false,        
                "options": {
                  "values": [
                    "upcoming",
                    "upcomingspecial",
                    "upcomingspecialdesc"
                  ],
                  "default":"upcomingspecial"
                }
            },
            {
              "key": "event-refresh-interval",
              "type": "number",
              "label": "Event refresh interval in seconds, default is set to every ten minutes",
              "required": false,
              "options": {
                  "default": 600
              }
            },
            {
                "key": "language-rotation-interval",
                "type": "number",
                "label": "Language rotation interval in seconds. Supported languages are 'en','de' and 'it', if a language is selected this will be ignored.",
                "required": false,
                "options": {
                    "default": 30
                }
            },
            {
              "key": "background-color",
              "type": "text",
              "label": "background color style (Use Hex Code or HTML Color Names) ",
              "required": false,
              "options": {
                  "default": "#3c763d"
              }
            },
            {
                "key": "font-url",
                "type": "text",
                "label": "URL to a valid font css file",
                "required": false,
                "options": {
                    "default": "https://s3.eu-west-1.amazonaws.com/noi-fonts/source-sans-pro/style.css"
                }
            },
            {
                "key": "font-name",
                "type": "text",
                "label": "Name of the font loaded from the font URL",
                "required": false,
                "options": {
                    "default": "Source Sans Pro"
                }
            }
        ]
    }
}
